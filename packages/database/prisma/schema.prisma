generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// Accounts
model Account {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique // App User / Email address
  password  String? // Legacy plaintext app password
  passwordEnc String? // Encrypted app password envelope
  emailHost String // SMTP Host
  emailPort Int @default(587) // SMTP Port
  bulkNextAvailableAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Log       Log[]
  BulkSendBatch BulkSendBatch[]
  senders   Sender[]
}

model Project {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  status             ProjectStatus @default(ACTIVE)
  defaultRetentionDays Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  apiKeys            ApiKey[]
  senders            Sender[]
  contentArtifacts   ContentArtifact[]
  messages           Message[]
  webhookEndpoints   WebhookEndpoint[]
  webhookEvents      WebhookEvent[]
  auditEvents        AuditEvent[]
  managedTemplates   ManagedTemplate[]
  managedTemplateVersions ManagedTemplateVersion[]
}

model ApiKey {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  name       String
  prefix     String   @unique
  keyHash    String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, revokedAt])
}

model Sender {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id])
  alias          String
  displayName    String
  fromAddress    String
  replyTo        String?
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  status         SenderStatus @default(ACTIVE)
  verifiedAt     DateTime?
  maxConcurrency Int?
  maxPerMinute   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  messages       Message[]

  @@unique([projectId, alias])
  @@index([accountId])
}

model ContentArtifact {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id])
  digest     String
  format     ArtifactFormat
  byteLength Int
  content    String?
  objectKey  String?
  createdAt  DateTime       @default(now())
  htmlMessages Message[]    @relation("MessageHtmlArtifact")
  textMessages Message[]    @relation("MessageTextArtifact")
  managedTemplateVersions ManagedTemplateVersion[]

  @@unique([projectId, digest, format])
  @@index([projectId, createdAt])
}

model ManagedTemplate {
  id              String   @id
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  activeVersionId String?  @unique
  activeVersion   ManagedTemplateVersion? @relation("ActiveManagedTemplateVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        ManagedTemplateVersion[] @relation("ManagedTemplateVersions")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, updatedAt])
}

model ManagedTemplateVersion {
  id             String          @id
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId     String
  template       ManagedTemplate @relation("ManagedTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  digest         String
  format         ArtifactFormat
  sourceArtifactId String
  sourceArtifact ContentArtifact @relation(fields: [sourceArtifactId], references: [id])
  subject        String?
  variableSchema Json?
  activeFor      ManagedTemplate? @relation("ActiveManagedTemplateVersion")
  createdAt      DateTime         @default(now())

  @@unique([templateId, digest])
  @@index([projectId, createdAt])
  @@index([sourceArtifactId])
}

model Message {
  id                    String   @id
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id])
  senderId              String
  sender                Sender   @relation(fields: [senderId], references: [id])
  recipient             String
  resolvedFrom          String
  resolvedReplyTo       String?
  subject               String
  htmlArtifactId        String
  htmlArtifact          ContentArtifact @relation("MessageHtmlArtifact", fields: [htmlArtifactId], references: [id])
  textArtifactId        String?
  textArtifact          ContentArtifact? @relation("MessageTextArtifact", fields: [textArtifactId], references: [id])
  tags                  Json     @default("{}")
  idempotencyKey        String?
  requestDigest         String
  requestId             String
  correlationId         String
  status                Status   @default(ENQUEUE_PENDING)
  retryCount            Int      @default(0)
  nextAttemptAt         DateTime?
  lastAttemptAt         DateTime?
  processingOwner       String?
  processingLeaseExpiresAt DateTime?
  deliveryAttemptStartedAt DateTime?
  failureClass          String?
  lastError             String?
  acceptedAt            DateTime @default(now())
  queuedAt              DateTime?
  completedAt           DateTime?
  retentionUntil        DateTime?
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  webhookEvents         WebhookEvent[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, processingLeaseExpiresAt])
  @@index([senderId])
  @@index([htmlArtifactId])
  @@index([textArtifactId])
}

model WebhookEndpoint {
  id                    String                @id
  projectId             String
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url                   String
  description           String?
  signingSecretEnc      String
  previousSecretEnc     String?
  previousSecretExpiresAt DateTime?
  eventTypes            WebhookEventType[]
  status                WebhookEndpointStatus @default(ACTIVE)
  consecutiveFailures   Int                   @default(0)
  lastSuccessAt         DateTime?
  lastFailureAt         DateTime?
  disabledAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deliveries            WebhookDelivery[]

  @@index([projectId, status])
}

model WebhookEvent {
  id         String           @id
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messageId  String?
  message    Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  type       WebhookEventType
  payload    Json
  occurredAt DateTime         @default(now())
  createdAt  DateTime         @default(now())
  deliveries WebhookDelivery[]

  @@index([projectId, occurredAt])
  @@index([messageId, occurredAt])
}

model WebhookDelivery {
  id               String                @id
  eventId          String
  event            WebhookEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId       String
  endpoint         WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  targetUrl        String
  signingSecretEnc String
  status           WebhookDeliveryStatus @default(PENDING)
  attemptCount     Int                   @default(0)
  nextAttemptAt    DateTime               @default(now())
  processingOwner  String?
  leaseExpiresAt   DateTime?
  responseStatus   Int?
  responseSummary  String?
  lastError        String?
  deliveredAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

model AuditEvent {
  id            String   @id
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorApiKeyId String?
  action        String
  targetType    String
  targetId      String
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now())

  @@index([projectId, occurredAt])
  @@index([targetType, targetId])
}

// Templates
model Template {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  filename  String
  storageType STORAGE_TYPE @default(LOCAL)
  Log       Log[]
  BulkSendBatch BulkSendBatch[]
  Bucket    Bucket?   @relation(fields: [bucketId], references: [id])
  bucketId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Buckets
model Bucket {
  id        String   @id @default(cuid())
  name      String   @unique
  path      String
  accessKeyId String? // Legacy plaintext access key
  secretAccessKey String? // Legacy plaintext secret key
  accessKeyIdEnc String? // Encrypted access key envelope
  secretAccessKeyEnc String? // Encrypted secret key envelope
  region String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  templates Template[]
}

// Logs
model Log {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  recipient   String
  templateId  String
  template    Template  @relation(fields: [templateId], references: [id])
  values      Json      @default("{}")
  bulkBatchId String?
  bulkBatch   BulkSendBatch? @relation(fields: [bulkBatchId], references: [id])
  bulkItemId  String?   @unique
  bulkItem    BulkSendItem? @relation("BulkItemLog", fields: [bulkItemId], references: [id])
  scheduledFor DateTime?
  status      Status    @default(ENQUEUE_PENDING)
  enqueueKey  String?   @unique
  requestDigest String?
  correlationId String?
  retryCount  Int       @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  processingOwner String?
  processingLeaseExpiresAt DateTime?
  deliveryAttemptStartedAt DateTime?
  failureClass String?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, scheduledFor, createdAt])
  @@index([status, processingLeaseExpiresAt])
  @@index([bulkBatchId])
}

model BulkSendBatch {
  id                 String   @id @default(cuid())
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id])
  templateId         String
  template           Template @relation(fields: [templateId], references: [id])
  sharedValues       Json     @default("{}")
  requestedCount     Int
  acceptedCount      Int
  rejectedCount      Int
  enqueueKey         String?  @unique
  requestDigest      String?
  correlationId      String?
  requestedMinDelayMs Int?
  effectiveMinDelayMs Int
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  items              BulkSendItem[]
  logs               Log[]

  @@index([createdAt])
  @@index([accountId, createdAt])
}

model BulkSendItem {
  id              String   @id @default(cuid())
  batchId         String
  batch           BulkSendBatch @relation(fields: [batchId], references: [id])
  sequence        Int
  recipient       String
  values          Json     @default("{}")
  validationError String?
  log             Log?     @relation("BulkItemLog")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([batchId, sequence])
  @@index([batchId, validationError])
}

// Worker statuses
model WorkerHeartbeat {
  id            String   @id
  startedAt     DateTime @default(now())
  lastHeartbeat DateTime @default(now())
  version       String   @default("2.0.0")
  metadata      Json     @default("{}")

  @@map("worker_heartbeats")
}

enum STORAGE_TYPE {
  S3
  LOCAL
}

enum Status {
  ENQUEUE_PENDING
  QUEUED
  PROCESSING
  PENDING
  SENT
  FAILED
  RETRYING
  DEAD
  DELIVERY_UNCERTAIN
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
}

enum SenderStatus {
  ACTIVE
  DISABLED
}

enum ArtifactFormat {
  HTML
  TEXT
  MJML
}

enum WebhookEventType {
  MESSAGE_ACCEPTED
  MESSAGE_QUEUED
  MESSAGE_PROCESSING
  MESSAGE_RETRYING
  MESSAGE_SENT
  MESSAGE_FAILED
  MESSAGE_DEAD
  MESSAGE_DELIVERY_UNCERTAIN
  ENDPOINT_TEST
}

enum WebhookEndpointStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}
