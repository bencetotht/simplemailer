{
  "name": "@simplemailer/cli",
  "version": "0.1.0",
  "description": "Declarative configuration CLI for SimpleMailer",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "simplemailer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@simplemailer/contracts": "workspace:^",
    "@simplemailer/sdk": "workspace:^",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
